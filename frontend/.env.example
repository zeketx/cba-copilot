# The shell talks to the backend through the Vite proxy at /api.
# No secrets belong in the frontend.
# The hosted preview CSP allows this origin, VITE_SUPABASE_URL, and the official PDF origin.
VITE_API_BASE=
# Hosted project URL and anon key for passwordless OTP. Empty disables sign-in from this SPA.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
