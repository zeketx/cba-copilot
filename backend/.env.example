# Placeholder names only. Do not put real keys in this file.
# Same variable names as document-copilot. Model defaults follow backend/app/config.py.
# The sibling .env.example still lists gpt-4.1 for the chat model. This file follows
# the code default, gpt-5.5.

# --- Supabase (create a new project; see docs/guides/supabase-setup.md) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct connection, host db.<ref>.supabase.co. Not the transaction pooler.
# URL-encode special characters in the password.

DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI (needed only for a later live run; the skeleton does not call it) ---

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_GROUNDING_MODEL=gpt-4.1-mini
OPENAI_AGENT_REQUEST_LIMIT=20
OPENAI_AGENT_TEMPERATURE=0

# --- Retrieval ---

RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=8
RETRIEVAL_RRF_K=60
RETRIEVAL_NEIGHBOR_RADIUS=1
RETRIEVAL_FTS_CONFIG=english
RETRIEVAL_FTS_KEYWORD_MODEL=gpt-4.1-mini
RETRIEVAL_FTS_KEYWORD_MIN=3
RETRIEVAL_FTS_KEYWORD_MAX=5
RETRIEVAL_FTS_KEYWORD_FAST_PATH_TOKENS=5

# --- Server ---

ALLOWED_ORIGINS=http://localhost:5173
