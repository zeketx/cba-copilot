# Placeholder names only. Do not put real keys in this file.
# The offline demo does not read this file.

# --- Supabase (create a new project; see docs/guides/supabase-setup.md) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Direct connection, host db.<ref>.supabase.co. Not the transaction pooler.
# URL-encode special characters in the password.

DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Answer provider: openai, google, or openrouter ---
# Live calls stay disabled in this skeleton.

ANSWER_PROVIDER=openai
ANSWER_MODEL=
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=mongodb/voyage-4-lite
EMBEDDING_DIMENSIONS=1024
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Retrieval ---

RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=8
RETRIEVAL_RRF_K=60
RETRIEVAL_CONTEXT_PER_HIT=4
RETRIEVAL_CONTEXT_MAX=16
RETRIEVAL_FTS_CONFIG=english

# --- In-memory limits (one process; a restart clears them) ---
# POST /api/ask and POST /api/chat/stream share this budget per signed-in user.

ANSWER_RATE_LIMIT=10
ANSWER_RATE_WINDOW_SECONDS=60

# POST /api/access-requests, per client address.

ACCESS_REQUEST_RATE_LIMIT=5
ACCESS_REQUEST_RATE_WINDOW_SECONDS=600

# Distinct access-request emails this process will store.
# A repeat of a stored email still returns 200.

ACCESS_REQUEST_CAP=100

# --- Server ---

ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated emails admitted after a verified sign-in. Empty admits nobody.
ALLOWED_EMAILS=
